# pub reads this file instead of .gitignore, so it repeats those entries.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Personal planning notes (kept local, not published)
/PLUGIN_PLAN.md

# Repository-only files, not part of the published package
/openspec/
/.claude/
/RELEASE.md
/dart_test.yaml
# README images: linked from GitHub, so the package needn't carry them
/doc/images/
